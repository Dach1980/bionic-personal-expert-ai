# Keycloak realm configuration (use the exact issuer URL from realm discovery)
OIDC_ISSUER=http://localhost:30000/oidc/realms/bionic-gpt
OIDC_AUDIENCE=pea-api
OIDC_JWKS_URL=http://host.docker.internal:30000/oidc/realms/bionic-gpt/protocol/openid-connect/certs

# PEA API reachable from the Bionic container. On Docker Desktop this resolves to the host.
PEA_API_BASE_URL=http://host.docker.internal:8000

# Exact public Pages SPA origin; no path and no wildcard.
PEA_WEB_ORIGIN=https://dach1980.github.io
